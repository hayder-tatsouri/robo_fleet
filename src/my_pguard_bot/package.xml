<?xml version="1.0"?>
<package format="3">
  <name>my_pguard_bot</name>
  <version>0.1.0</version>
  <description>
    Simulation of an Enova Robotics PGuard-class outdoor security robot,
    georeferenced to Novation City / Technopole de Sousse, Tunisia.
    ROS 2 Jazzy + Gazebo Harmonic.
  </description>
  <maintainer email="dev@example.com">dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
